---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Luigi Caloi" description="This page does not exist. Visit the home, research or teaching pages of Luigi Caloi's website." path="/404" noindex>
  <section class="band-gray notfound">
    <h1>Page not found</h1>
    <p>This page doesn't exist. Try the <a href="/">home page</a>, <a href="/research">research</a> or <a href="/teaching">teaching</a>.</p>
  </section>
</Base>

<style>
  .notfound {
    padding: 80px max(16px, calc(50% - 702px)) 120px;
  }
  h1 {
    font-size: 40px;
    line-height: 56px;
  }
  p {
    margin-top: 16px;
    font-size: 18px;
    line-height: 30px;
  }
</style>
